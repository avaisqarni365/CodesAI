# FTP Deployment Configuration
# Copy this file to .env.deploy and fill in your credentials
# NEVER commit .env.deploy to Git!

FTP_SERVER=ftp.codes-ai.com
FTP_USERNAME=your_username@codes-ai.com
FTP_PASSWORD=your_secure_password
FTP_SERVER_DIR=/public_html/

# Optional: Port (default is 21)
# FTP_PORT=21

# Optional: Use SFTP instead of FTP
# USE_SFTP=false
